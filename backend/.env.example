# Copy this file to backend/.env and replace placeholders locally.
# Never commit real credentials or connection strings.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one trusted reverse proxy (for example, Render).
TRUST_PROXY=0
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pritum_portfolio?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

# Admin provisioning. Keep these credentials private.
# Set to 1 only when intentionally creating/updating an Admin account.
# Normal Render builds should leave this at 0 to avoid resetting passwords.
ALLOW_ADMIN_PROVISIONING=0
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARS

# To make this account the single Super Admin, set SUPER_ADMIN_EMAIL
# to the same email as ADMIN_EMAIL before running: npm run create-admin.
SUPER_ADMIN_EMAIL=admin@example.com
